{
  "name": "proinspect",
  "main": "./cloudflare/worker.js",
  "compatibility_date": "2026-08-23",
  "keep_vars": true,
  "assets": {
    "directory": "./apps/web/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/v1/*", "/health"]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  }
}
