rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Allow users to read and maintain their user profile
    match /users/{userId} {
      allow read, write: if isUser(userId);
    }

    // The browser may read and maintain its own membership
    match /agencies/{agencyId}/memberships/{uid} {
      allow read, write: if isUser(uid);
    }

    // Operational data is server-authoritative. Browser access goes through the
    // authenticated API, which applies agency, capability, assignment and lifecycle policy.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}

