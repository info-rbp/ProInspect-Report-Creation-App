rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function isUser(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    // Allow users to read and maintain their user profile
    match /users/{userId} {
      allow read, write: if isUser(userId);
    }

    // The browser may read and maintain its own agency membership.
    match /agencies/{agencyId}/memberships/{uid} {
      allow read, write: if isUser(uid);
    }

    // Provider membership is server-managed, but a signed-in user may read their
    // own record so the web shell can recognise an explicitly provisioned
    // ProInspect super administrator without granting browser write access.
    match /serviceProviders/{providerId}/memberships/{uid} {
      allow read: if isUser(uid);
      allow write: if false;
    }

    // Operational data is server-authoritative. Browser access goes through the
    // authenticated API, which applies agency, capability, assignment and lifecycle policy.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
