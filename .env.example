VITE_APP_NAME=ProInspect
VITE_API_BASE_URL=
VITE_GEMINI_API_KEY=

GEMINI_API_KEY=
PUBLIC_API_BASE_URL=
WEB_APP_BASE_URL=

# Tenant communication delivery
# Deployed environments read this JSON from Secret Manager secret `email-provider-config`.
# Local development can provide the same JSON directly with NOTIFICATION_PROVIDER_CONFIG.
# Example shape (use real secrets only outside source control):
# {"sendgridApiKey":"...","sendgridFromEmail":"property@example.com","sendgridFromName":"ProInspect","twilioAccountSid":"...","twilioAuthToken":"...","twilioFromNumber":"+61...","callbackSecret":"random-long-secret"}
NOTIFICATION_PROVIDER_CONFIG=
NOTIFICATION_CALLBACK_BASE_URL=
NOTIFICATION_CALLBACK_SECRET=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=ProInspect
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# Shopify custom-app integration
SHOPIFY_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=

# Google Calendar OAuth integration
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=

# Xero maintenance accounting integration
XERO_CLIENT_ID=
XERO_CLIENT_SECRET=
XERO_REDIRECT_URI=
# Override only when the connected Xero application uses different granular scopes.
XERO_SCOPES="openid profile email offline_access accounting.transactions accounting.contacts accounting.settings"

# Integration credential and command security
# Generate a random 32-byte key and store it in Secret Manager in deployed environments.
INTEGRATION_TOKEN_ENCRYPTION_KEY=
INTEGRATION_TOKEN_KEY_VERSION=v1
INTEGRATION_STATE_SECRET=
AUTOMATION_RUNNER_SECRET=
