VITE_APP_NAME=ProInspect
# Non-Cloudflare deployments can set an absolute API origin. The Cloudflare build forces same-origin '/api' routing.
VITE_API_BASE_URL=
# Development only: permits same-origin /api requests through the Vite proxy.
VITE_USE_DEV_API_PROXY=true
# Explicit demo mode only. Never use API failure as an implicit demo-data trigger.
VITE_DEMO_MODE=false

# Firebase web configuration. These are deployment configuration values, not server credentials.
# Cloudflare production has a checked-in public fallback in firebase-cloudflare-config.json;
# environment values override that fallback when supplied.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_FIRESTORE_DATABASE_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_FIREBASE_APP_CHECK_SITE_KEY=

# Cloudflare Worker runtime configuration.
GOOGLE_API_ORIGIN=
# Generate once and store the same value as a Cloudflare Worker secret and a Google backend secret.
CLOUDFLARE_ORIGIN_SECRET=

# Google/backend secrets remain on the Google backend while Cloudflare operates as the edge and SPA host.
GEMINI_API_KEY=
PUBLIC_API_BASE_URL=
WEB_APP_BASE_URL=
UPLOAD_BUCKET=
REQUIRE_APP_CHECK=true
PROINSPECT_PROVIDER_ID=proinspect
PROINSPECT_PROVIDER_ADMIN_EMAIL=info@remotebusinesspartner.com.au
PROINSPECT_HOME_AGENCY_ID=agency-1

NOTIFICATION_PROVIDER_CONFIG=
NOTIFICATION_CALLBACK_BASE_URL=
NOTIFICATION_CALLBACK_SECRET=
SENDGRID_API_KEY=
SENDGRID_FROM_EMAIL=
SENDGRID_FROM_NAME=ProInspect
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SHOPIFY_API_VERSION=2026-07
SHOPIFY_WEBHOOK_SECRET=
GOOGLE_CALENDAR_CLIENT_ID=
GOOGLE_CALENDAR_CLIENT_SECRET=
GOOGLE_CALENDAR_REDIRECT_URI=
INTEGRATION_TOKEN_ENCRYPTION_KEY=
INTEGRATION_TOKEN_KEY_VERSION=v1
INTEGRATION_STATE_SECRET=
AUTOMATION_RUNNER_SECRET=
