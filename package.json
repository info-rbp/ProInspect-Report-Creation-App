{
  "name": "property-condition-report-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.8",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @pcr/web",
    "dev:api": "npm run dev --workspace @pcr/api",
    "dev:local": "node scripts/dev-local.mjs",
    "emulators": "firebase emulators:start --config infrastructure/firebase/firebase.json --import=.firebase-emulator-data --export-on-exit=.firebase-emulator-data",
    "build": "npm run build:packages && npm run build:apps",
    "build:packages": "npm run build --workspace @pcr/domain && npm run build --workspace @pcr/config && npm run build --workspace @pcr/validation && npm run build --workspace @pcr/templates && npm run build --workspace @pcr/report-presentation && npm run build --workspace @pcr/testing && npm run build --workspace @pcr/ui && npm run build --workspace @pcr/appwrite-client && npm run build --workspace @pcr/appwrite-server",
    "build:apps": "npm run build --workspace @pcr/web && npm run build --workspace @pcr/api && npm run build --workspace @pcr/ai-worker && npm run build --workspace @pcr/pdf-worker && npm run build --workspace @pcr/notification-worker && npm run build --workspace @pcr/dashboard-worker && npm run build --workspace @pcr/document-worker && npm run build --workspace @pcr/integration-worker",
    "cloudflare:install": "npm ci --include=dev --ignore-scripts --no-audit --no-fund",
    "cloudflare:verify": "node scripts/verify-cloudflare-build-inputs.mjs",
    "cloudflare:build": "npm run cloudflare:verify && node scripts/build-cloudflare.mjs",
    "cloudflare:ci": "npm run cloudflare:install && npm run cloudflare:build",
    "cloudflare:deploy": "npx wrangler deploy",
    "cloudflare:preview": "npx wrangler versions upload",
    "security:scan": "node scripts/scan-secrets.mjs",
    "strata:verify-parity": "node scripts/verify-strata-feature-parity.mjs",
    "appwrite:generate": "node infrastructure/appwrite/scripts/generate-resources.mjs",
    "appwrite:validate": "npm run appwrite:generate && node infrastructure/appwrite/scripts/validate-config.mjs",
    "appwrite:prepare:development": "node infrastructure/appwrite/scripts/materialize-development-config.mjs",
    "appwrite:push:development": "node infrastructure/appwrite/scripts/push-development.mjs",
    "appwrite:verify": "node infrastructure/appwrite/scripts/verify-remote-schema.mjs",
    "appwrite:audit:development": "node infrastructure/appwrite/scripts/audit-development-control-plane.mjs",
    "appwrite:seed:development": "node infrastructure/appwrite/scripts/seed-development.mjs",
    "appwrite:test:development": "node infrastructure/appwrite/scripts/test-development-workflow.mjs",
    "appwrite:smoke:portals": "node infrastructure/appwrite/scripts/test-seven-portals-development.mjs",
    "appwrite:clear-seed:development": "node infrastructure/appwrite/scripts/clear-development-seed.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run build:packages && npm run typecheck:workspaces",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:run",
    "test:run": "npm run test:unit && npm run test:rules",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:emulator": "firebase emulators:exec --only firestore,storage --config infrastructure/firebase/firebase.json \"vitest run --config vitest.emulator.config.ts\"",
    "test:e2e": "playwright test",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "verify:dist": "node scripts/verify-built-artifacts.mjs",
    "provision:provider-admin": "node scripts/provision-provider-admin.mjs",
    "smoke:api": "node scripts/smoke-api-routes.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:run && npm run appwrite:validate && npm run build && npm run verify:dist",
    "upgrade:status": "node infrastructure/upgrades/platform-completion-v1/upgrade.mjs status",
    "upgrade:preflight": "node infrastructure/upgrades/platform-completion-v1/upgrade.mjs preflight",
    "upgrade:apply": "node infrastructure/upgrades/platform-completion-v1/upgrade.mjs apply",
    "upgrade:verify": "node infrastructure/upgrades/platform-completion-v1/upgrade.mjs verify",
    "upgrade:audit": "node infrastructure/upgrades/platform-completion-v1/package-audit.mjs",
    "upgrade:local": "node infrastructure/upgrades/platform-completion-v1/upgrade.mjs local",
    "upgrade:install": "node infrastructure/upgrades/platform-completion-v1/upgrade.mjs install",
    "upgrade:ci": "node infrastructure/upgrades/platform-completion-v1/upgrade.mjs ci",
    "prepare": "node scripts/verify-workspace.mjs",
    "launch:init": "node infrastructure/upgrades/launch-readiness-v2/cli.mjs init",
    "launch:audit": "node infrastructure/upgrades/launch-readiness-v2/cli.mjs audit",
    "launch:local": "node infrastructure/upgrades/launch-readiness-v2/cli.mjs local",
    "launch:plan": "node infrastructure/upgrades/launch-readiness-v2/cli.mjs plan",
    "launch:doctor": "node infrastructure/upgrades/launch-readiness-v2/cli.mjs doctor",
    "launch:complete": "node infrastructure/upgrades/launch-readiness-v2/cli.mjs complete",
    "launch:install": "node infrastructure/upgrades/launch-readiness-v2/cli.mjs install",
    "launch:verify": "node infrastructure/upgrades/launch-readiness-v2/cli.mjs verify",
    "launch:deploy": "node infrastructure/upgrades/launch-readiness-v2/cli.mjs deploy",
    "launch:status": "node infrastructure/upgrades/launch-readiness-v2/cli.mjs status",
    "launch:gate": "node infrastructure/upgrades/launch-readiness-v2/cli.mjs gate",
    "launch:unlock": "node infrastructure/upgrades/launch-readiness-v2/cli.mjs unlock",
    "launch:test": "node --test infrastructure/upgrades/launch-readiness-v2/tests/*.test.mjs",
    "launch:evidence": "node infrastructure/upgrades/launch-readiness-v2/external-evidence.mjs",
    "launch:release": "node infrastructure/upgrades/launch-readiness-v2/release.mjs",
    "launch:authority": "node infrastructure/upgrades/launch-readiness-v2/actions/runtime-authority.mjs",
    "launch:preflight": "node infrastructure/upgrades/launch-readiness-v2/cli.mjs preflight",
    "launch:check": "node infrastructure/upgrades/launch-readiness-v2/cli.mjs check",
    "launch:issues": "node infrastructure/upgrades/launch-readiness-v2/cli.mjs issues",
    "launch:reconcile": "node infrastructure/upgrades/launch-readiness-v2/cli.mjs reconcile",
    "launch:repair": "node infrastructure/upgrades/launch-readiness-v2/cli.mjs repair"
  },
  "dependencies": {
    "@google/genai": "^1.32.0",
    "firebase": "^12.6.0",
    "heic2any": "^0.0.4",
    "idb": "8.0.0",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.17.0",
    "read-excel-file": "9.3.10"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.55.0",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.25.1",
    "firebase-tools": "^14.12.0",
    "jsdom": "^26.1.0",
    "tsx": "^4.23.5",
    "typescript": "~5.8.2",
    "typescript-eslint": "^8.30.1",
    "vite": "^6.2.0",
    "vitest": "^3.2.4",
    "wrangler": "4.120.0"
  },
  "overrides": {
    "gaxios@<7": {
      "uuid": "^11.1.1"
    }
  }
}
