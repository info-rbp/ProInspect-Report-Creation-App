{
  "name": "property-condition-report-platform",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "npm@10.9.2",
  "engines": {
    "node": "22.x"
  },
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "npm run dev --workspace @pcr/web",
    "dev:api": "npm run dev --workspace @pcr/api",
    "dev:local": "node scripts/dev-local.mjs",
    "emulators": "firebase emulators:start --config infrastructure/firebase/firebase.json --import=.firebase-emulator-data --export-on-exit=.firebase-emulator-data",
    "build": "npm run build:packages && npm run build:apps",
    "build:packages": "npm run build --workspace @pcr/domain && npm run build --workspace @pcr/config && npm run build --workspace @pcr/validation && npm run build --workspace @pcr/templates && npm run build --workspace @pcr/report-presentation && npm run build --workspace @pcr/testing && npm run build --workspace @pcr/ui && npm run build --workspace @pcr/appwrite-client && npm run build --workspace @pcr/appwrite-server",
    "build:apps": "npm run build --workspace @pcr/web && npm run build --workspace @pcr/api && npm run build --workspace @pcr/ai-worker && npm run build --workspace @pcr/pdf-worker && npm run build --workspace @pcr/notification-worker && npm run build --workspace @pcr/dashboard-worker && npm run build --workspace @pcr/document-worker && npm run build --workspace @pcr/integration-worker",
    "cloudflare:install": "npm ci --include=dev --ignore-scripts --no-audit --no-fund",
    "cloudflare:verify": "node scripts/verify-cloudflare-build-inputs.mjs",
    "cloudflare:build": "npm run cloudflare:verify && node scripts/build-cloudflare.mjs",
    "cloudflare:ci": "npm run cloudflare:install && npm run cloudflare:build",
    "cloudflare:deploy": "npx wrangler deploy",
    "cloudflare:preview": "npx wrangler versions upload",
    "security:scan": "node scripts/scan-secrets.mjs",
    "appwrite:generate": "node infrastructure/appwrite/scripts/generate-resources.mjs",
    "appwrite:validate": "node infrastructure/appwrite/scripts/validate-config.mjs",
    "appwrite:prepare:development": "node infrastructure/appwrite/scripts/materialize-development-config.mjs",
    "appwrite:push:development": "node infrastructure/appwrite/scripts/push-development.mjs",
    "appwrite:verify": "node infrastructure/appwrite/scripts/verify-remote-schema.mjs",
    "appwrite:audit:development": "node infrastructure/appwrite/scripts/audit-development-control-plane.mjs",
    "appwrite:seed:development": "node infrastructure/appwrite/scripts/seed-development.mjs",
    "appwrite:test:development": "node infrastructure/appwrite/scripts/test-development-workflow.mjs",
    "appwrite:clear-seed:development": "node infrastructure/appwrite/scripts/clear-development-seed.mjs",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "npm run build:packages && npm run typecheck:workspaces",
    "typecheck:workspaces": "npm run typecheck --workspaces --if-present",
    "test": "npm run test:run",
    "test:run": "npm run test:unit && npm run test:rules",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:rules": "vitest run --config vitest.rules.config.ts",
    "test:emulator": "firebase emulators:exec --only firestore,storage --config infrastructure/firebase/firebase.json \"vitest run --config vitest.emulator.config.ts\"",
    "test:e2e": "playwright test",
    "format": "node scripts/format.mjs --write",
    "format:check": "node scripts/format.mjs --check",
    "verify:dist": "node scripts/verify-built-artifacts.mjs",
    "provision:provider-admin": "node scripts/provision-provider-admin.mjs",
    "smoke:api": "node scripts/smoke-api-routes.mjs",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm run test:run && npm run build && npm run verify:dist",
    "prepare": "node scripts/verify-workspace.mjs"
  },
  "dependencies": {
    "@google/genai": "^1.32.0",
    "firebase": "^12.6.0",
    "heic2any": "^0.0.4",
    "idb": "8.0.0",
    "lucide-react": "^0.556.0",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-router-dom": "^7.17.0",
    "read-excel-file": "9.3.10"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@firebase/rules-unit-testing": "^5.0.1",
    "@playwright/test": "^1.63.0",
    "@types/node": "^22.20.2",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.1.1",
    "eslint": "^10.10.0",
    "firebase-tools": "^15.30.0",
    "jsdom": "^30.0.1",
    "tsx": "^4.23.13",
    "typescript": "~7.0.2",
    "typescript-eslint": "^8.70.0",
    "vite": "^8.2.2",
    "vitest": "^5.0.0",
    "wrangler": "4.130.0"
  },
  "overrides": {
    "gaxios@<7": {
      "uuid": "^11.1.1"
    }
  }
}
