    "test:run": "vitest run --passWithNoTests",
    "start": "node dist/server.js"
  },
  "dependencies": {
    "@pcr/appwrite-server": "*",
    "@pcr/config": "*",
    "@pcr/domain": "*",
    "@pcr/report-presentation": "*",
    "@pcr/validation": "*",
    "pdf-lib": "^1.17.1"
  }
}
