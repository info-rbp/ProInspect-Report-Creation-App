    "start": "node dist/index.js"
  },
  "dependencies": {
    "@google/genai": "^1.32.0",
    "@pcr/config": "*",
    "@pcr/domain": "*",
    "@pcr/validation": "*",
    "firebase-admin": "^14.2.0"
  }
}
