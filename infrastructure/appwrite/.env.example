# Public project configuration. Use a project whose live name contains "Development".
APPWRITE_ENDPOINT=https://syd.cloud.appwrite.io/v1
APPWRITE_PROJECT_ID=
APPWRITE_PROJECT_NAME=ProInspect Development
APPWRITE_DATABASE_ID=proinspect_core

# Server-only secret. Create a least-privilege Development key; never expose it through Vite variables.
APPWRITE_API_KEY=

# Seed-only credential supplied at execution time. Never commit a real or reusable password.
APPWRITE_SEED_PASSWORD=

# Destructive seed cleanup requires both values exactly as shown.
APPWRITE_ENVIRONMENT=development
APPWRITE_CONFIRM_CLEAR=clear-development-seed
