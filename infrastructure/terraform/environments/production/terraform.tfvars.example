project_id         = "pcr-production-example"
billing_account_id = "000000-000000-000000"
monthly_budget_aud = 2000

identity_authorized_domains = [
  "app.example.com",
  "pcr-production-example.web.app",
]

notification_emails = [
  "platform-alerts@example.com",
  "finance-alerts@example.com",
]

report_retention_days = 365

# Do not change to ENFORCED until staging App Check metrics and authentication,
# Firestore and Storage acceptance pass. The public site key must also be supplied
# to the web build as VITE_FIREBASE_APP_CHECK_SITE_KEY.
app_check_recaptcha_enterprise_site_key = null
app_check_enforcement_mode              = "UNENFORCED"
