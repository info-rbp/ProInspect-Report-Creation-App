# Deliberately not the prohibited legacy Google/Firebase project. Replace this with
# the dedicated, environment-labelled ProInspect Production Google Cloud project.
project_id         = "proinspect-production-gcp"
billing_account_id = "000000-000000-000000"
monthly_budget_aud = 2000

notification_emails = [
  "platform-alerts@example.com",
  "finance-alerts@example.com",
]

# Must exactly match appwrite.runtimeCredentialPolicies service/secretId pairs in the private Production release configuration.
appwrite_runtime_secret_ids = {
  api                   = "proinspect-api-appwrite"
  "pdf-worker"          = "proinspect-pdf-worker-appwrite"
  "notification-worker" = "proinspect-notification-worker-appwrite"
  "dashboard-worker"    = "proinspect-dashboard-worker-appwrite"
  "document-worker"     = "proinspect-document-worker-appwrite"
  "integration-worker"  = "proinspect-integration-worker-appwrite"
}
