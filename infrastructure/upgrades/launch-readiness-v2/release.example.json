{
  "schemaVersion": 1,
  "providerStack": ["appwrite", "google-cloud", "cloudflare", "shopify"],
  "environments": {
    "production": {
      "appwrite": {
        "endpoint": "https://syd.cloud.appwrite.io/v1",
        "projectId": null,
        "projectName": null,
        "databaseId": "proinspect_core",
        "approvedRuntimeKeys": [],
        "runtimeCredentialPolicies": []
      },
      "google": {
        "projectId": null,
        "region": "australia-southeast1",
        "environment": "production",
        "services": ["api", "pdf-worker", "notification-worker", "dashboard-worker", "document-worker", "integration-worker"],
        "aiRuntime": "api",
        "imageRepository": "pcr-containers",
        "requiredApis": ["run.googleapis.com", "artifactregistry.googleapis.com", "secretmanager.googleapis.com", "cloudbuild.googleapis.com", "monitoring.googleapis.com", "logging.googleapis.com", "calendar-json.googleapis.com"],
        "runtimeBindings": {
          "api": {
            "env": {
              "AUTH_PROVIDER": "appwrite",
              "APPWRITE_BACKEND_MODE": "appwrite",
              "NODE_ENV": "production",
              "PUBLIC_API_BASE_URL": null,
              "WEB_APP_BASE_URL": null,
              "SHOPIFY_API_VERSION": "2026-07",
              "GOOGLE_CALENDAR_CLIENT_ID": null,
              "GOOGLE_CALENDAR_REDIRECT_URI": null,
              "INTEGRATION_TOKEN_KEY_VERSION": "v1"
            },
            "secretRefs": {}
          },
          "pdf-worker": {"env": {"AUTH_PROVIDER": "appwrite", "APPWRITE_BACKEND_MODE": "appwrite"}, "secretRefs": {}},
          "notification-worker": {"env": {"AUTH_PROVIDER": "appwrite", "APPWRITE_BACKEND_MODE": "appwrite"}, "secretRefs": {}},
          "dashboard-worker": {"env": {"AUTH_PROVIDER": "appwrite", "APPWRITE_BACKEND_MODE": "appwrite"}, "secretRefs": {}},
          "document-worker": {"env": {"AUTH_PROVIDER": "appwrite", "APPWRITE_BACKEND_MODE": "appwrite"}, "secretRefs": {}},
          "integration-worker": {"env": {"AUTH_PROVIDER": "appwrite", "APPWRITE_BACKEND_MODE": "appwrite"}, "secretRefs": {}}
        }
      },
      "cloudflare": {
        "accountId": null,
        "workerName": null,
        "apiOrigin": null,
        "trustedEdgeSecretEnv": "PROINSPECT_EDGE_SECRET",
        "contentSecurityPolicy": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://syd.cloud.appwrite.io; connect-src 'self' https://syd.cloud.appwrite.io wss://syd.cloud.appwrite.io; object-src 'none'; frame-ancestors 'none'; base-uri 'self'"
      },
      "shopify": {
        "domain": "proinspect-2.myshopify.com",
        "apiVersion": "2026-07",
        "tokenEnv": "SHOPIFY_ADMIN_ACCESS_TOKEN",
        "agencyId": null,
        "webhookUri": null
      },
      "web": {
        "origin": null,
        "healthPath": "/health",
        "revisionField": "commit",
        "deniedPath": "/api/v1/platform/portal-entitlements/me"
      },
      "terraform": {
        "root": "infrastructure/terraform/environments/production",
        "variablesFile": null,
        "backendFile": null
      },
      "migration": {
        "bundleDirectory": null,
        "bundleSha256": null,
        "rollbackApproved": false
      },
      "backup": {
        "directory": null,
        "freezeApproved": false
      },
      "rollback": {
        "googleRecord": null,
        "cloudflareRecord": null
      }
    }
  },
  "releaseControl": {
    "productionMutationEnabled": false,
    "approvedBy": null,
    "approvedAt": null,
    "approvedCommit": null,
    "changeTicket": null,
    "releaseWindowStart": null,
    "releaseWindowEnd": null,
    "rollbackWindowHours": 24,
    "supportOwner": null,
    "supportReady": false,
    "legacyWriteFreezeApproved": false,
    "finalMigrationDeltaApproved": false,
    "legacyRetirementApproved": false
  }
}
